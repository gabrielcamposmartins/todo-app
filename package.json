{
  "name": "todo-overlay",
  "version": "0.1.0",
  "description": "Overlay de lista de tarefas transparente, sempre no topo e com click-through.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.todooverlay.app",
    "productName": "TODO-APP",
    "publish": [
      {
        "provider": "github",
        "owner": "gabrielcamposmartins",
        "repo": "todo-app"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TODO-APP",
      "artifactName": "TODO-APP-Setup-${version}.${ext}"
    }
  }
}
